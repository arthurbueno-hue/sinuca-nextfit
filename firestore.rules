rules_version = '2';
// O navegador nunca acessa o Firestore diretamente: todo acesso passa pelo
// servidor (Next.js) usando o Admin SDK, que ignora estas regras.
// Qualquer tentativa direta do cliente é negada.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
