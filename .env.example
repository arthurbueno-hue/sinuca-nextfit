# ===== Login (Auth.js) =====
# Gere com: node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET=
# Endereço público do site (produção), ex.: https://seu-app.up.railway.app
AUTH_URL=
# OAuth Client (Google Cloud Console > Google Auth Platform > Clientes)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ===== Regras de acesso =====
ALLOWED_DOMAIN=nextfit.com.br
# E-mails dos ADMs separados por vírgula
ADMIN_EMAILS=

# ===== Banco =====
# postgres (Railway) | firestore | memory (só teste local)
DATA_BACKEND=postgres
# Na Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# ===== Somente teste local (ignorado em produção) =====
# DATA_BACKEND=memory
# DEV_LOGIN=1
