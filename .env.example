# ===== Auth.js =====
# Gere com: npx auth secret   (ou: openssl rand -base64 33)
AUTH_SECRET=
# OAuth Client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ===== Regras de acesso =====
ALLOWED_DOMAIN=nextfit.com.br
ADMIN_EMAILS=arthur.bueno@nextfit.com.br,felipe.feijo@nextfit.com.br

# ===== Firestore =====
# JSON da service account codificado em base64 (veja README)
FIREBASE_SERVICE_ACCOUNT=

# ===== Somente desenvolvimento local (ignorados em produção) =====
# DATA_BACKEND=memory   -> banco em memória, sem Firebase
# DEV_LOGIN=1           -> campo "Teste local" na tela de login (só no npm run dev)
# DATA_BACKEND=memory
# DEV_LOGIN=1
